 103:Core/Src/main.c **** 
 104:Core/Src/main.c ****   /* Infinite loop */
 105:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 106:Core/Src/main.c ****   while (1)
 107:Core/Src/main.c ****   {
 108:Core/Src/main.c ****     /* USER CODE END WHILE */
 109:Core/Src/main.c **** 
 110:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 111:Core/Src/main.c ****     if (HAL_GetTick() - last_tick >= 1000)  // mỗi 1 giây
 112:Core/Src/main.c ****     {
 113:Core/Src/main.c ****       last_tick = HAL_GetTick();
 114:Core/Src/main.c **** 
 115:Core/Src/main.c ****       // Nháy LED để biết chương trình đang chạy (debug)
 116:Core/Src/main.c ****       HAL_GPIO_TogglePin(GPIOC, GPIO_PIN_13);
 117:Core/Src/main.c **** 
 118:Core/Src/main.c ****       // Bắt đầu chuyển đổi ADC
 119:Core/Src/main.c ****       HAL_ADC_Start(&hadc1);
 120:Core/Src/main.c ****       if (HAL_ADC_PollForConversion(&hadc1, 10) == HAL_OK)
 121:Core/Src/main.c ****       {
 122:Core/Src/main.c ****         adc_value = HAL_ADC_GetValue(&hadc1);
 123:Core/Src/main.c ****       }
 124:Core/Src/main.c ****       HAL_ADC_Stop(&hadc1);
 125:Core/Src/main.c **** 
 126:Core/Src/main.c ****       // Quy đổi ADC (12 bit, 0-4095) sang điện áp (0 - 3.3V)
 127:Core/Src/main.c ****       voltage = (adc_value * 3.3f) / 4095.0f;
 128:Core/Src/main.c **** 
 129:Core/Src/main.c ****       // Đóng gói chuỗi và gửi qua UART
 130:Core/Src/main.c ****       int len = sprintf(uart_buf, "ADC: %lu | Voltage: %.2f V\r\n",
 131:Core/Src/main.c ****                          adc_value, voltage);
 132:Core/Src/main.c ****       HAL_UART_Transmit(&huart1, (uint8_t*)uart_buf, len, HAL_MAX_DELAY);
 133:Core/Src/main.c ****     }
 134:Core/Src/main.c ****   }
