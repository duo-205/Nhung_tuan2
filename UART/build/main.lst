 104:Core/Src/main.c ****   while (1)
 105:Core/Src/main.c ****   {
 106:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 107:Core/Src/main.c ****   uint8_t rx_char;
 108:Core/Src/main.c **** 
 109:Core/Src/main.c ****   while (1)
 110:Core/Src/main.c ****   {
 111:Core/Src/main.c ****     if (HAL_UART_Receive(&huart1, &rx_char, 1, HAL_MAX_DELAY) == HAL_OK)
 112:Core/Src/main.c ****     {
 113:Core/Src/main.c ****       if (rx_char == '!')
 114:Core/Src/main.c ****       {
 115:Core/Src/main.c ****         rx_buffer[rx_index] = '\0';
 116:Core/Src/main.c **** 
 117:Core/Src/main.c ****         char tx_buffer[BUF_SIZE + 50];
 118:Core/Src/main.c ****         int len = sprintf(tx_buffer, "%s%s%s\n\r", MA_LOP, MA_NHOM, (char*)rx_buffer);
 119:Core/Src/main.c **** 
 120:Core/Src/main.c ****         HAL_UART_Transmit(&huart1, (uint8_t*)tx_buffer, len, HAL_MAX_DELAY);
 121:Core/Src/main.c **** 
 122:Core/Src/main.c ****         rx_index = 0;
 123:Core/Src/main.c ****       }
 124:Core/Src/main.c ****       else
 125:Core/Src/main.c ****       {
 126:Core/Src/main.c ****         if (rx_index < BUF_SIZE - 1)
 127:Core/Src/main.c ****         {
 128:Core/Src/main.c ****           rx_buffer[rx_index++] = rx_char;
 129:Core/Src/main.c ****         }
 130:Core/Src/main.c ****       }
 131:Core/Src/main.c ****     }
 132:Core/Src/main.c ****     /* USER CODE END WHILE */
 133:Core/Src/main.c **** 
 134:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 135:Core/Src/main.c ****   }
 136:Core/Src/main.c ****   /* USER CODE END 3 */
